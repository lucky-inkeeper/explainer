{
  "name": "explainer",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "Excalidraw MCP for Claude Code: Claude explains by drawing",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --mac --dir && rsync -a --delete dist/mac-arm64/Explainer.app/ /Applications/Explainer.app/",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "check": "node --test test/*.test.mjs",
    "sync:setup": "node build/sync-setup.mjs",
    "deploy:web": "electron-vite build && VERCEL_ORG_ID=team_CPHX1knfRFeyur6aspbm0zIJ VERCEL_PROJECT_ID=prj_8HCPxB6tkXx6vOK5gZoMPbOG8Iuu vercel deploy out/renderer --prod --yes",
    "postinstall": "d=node_modules/electron/dist; [ -d \"$d/Electron.app\" ] && mv \"$d/Electron.app\" \"$d/Explainer.app\"; a=\"$d/Explainer.app\"; [ -d \"$a\" ] && plutil -replace CFBundleName -string \"Explainer\" \"$a/Contents/Info.plist\" && plutil -replace CFBundleDisplayName -string \"Explainer\" \"$a/Contents/Info.plist\" && printf \"%s\" \"Explainer.app/Contents/MacOS/Electron\" > node_modules/electron/path.txt && codesign --force --deep --sign - \"$a\" >/dev/null 2>&1; true"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@vercel/blob": "2.8.0",
    "pako": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
